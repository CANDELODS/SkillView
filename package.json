{
  "name": "skillview",
  "version": "1.0.0",
  "description": "Proyecto para optar por el titulo de ingeniero de sistemas",
  "main": "index.js",
  "scripts": {
    "dev": "gulp dev",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:headed": "playwright test --project=chromium --headed",
    "test:e2e:ui": "playwright test --project=chromium --ui",
    "test:e2e:debug": "playwright test --project=chromium --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install chromium",
    "test:adaptabilidad:grupo1": "playwright test --config=playwright.adaptability.config.ts estructura-navegacion.spec.ts",
    "test:adaptabilidad:grupo1:headed": "playwright test --config=playwright.adaptability.config.ts estructura-navegacion.spec.ts --headed",
    "report:adaptabilidad:grupo1": "playwright show-report reports/adaptabilidad/grupo-1",
    "test:adaptabilidad:grupo2": "playwright test --config=playwright.adaptability.grupo2.config.ts",
    "test:adaptabilidad:grupo2:headed": "playwright test --config=playwright.adaptability.grupo2.config.ts --headed",
    "report:adaptabilidad:grupo2": "playwright show-report reports/adaptabilidad/grupo-2",
    "test:adaptabilidad:grupo3": "playwright test --config=playwright.adaptability.grupo3.config.ts",
    "test:adaptabilidad:grupo3:headed": "playwright test --config=playwright.adaptability.grupo3.config.ts --headed",
    "report:adaptabilidad:grupo3": "playwright show-report reports/adaptabilidad/grupo-3",
    "test:adaptabilidad:grupo4": "playwright test -c playwright.adaptability.grupo4.config.ts",
    "test:adaptabilidad:grupo4:headed": "playwright test -c playwright.adaptability.grupo4.config.ts --headed",
    "report:adaptabilidad:grupo4": "playwright show-report reports/adaptabilidad/grupo-4",
    "test:adaptabilidad:grupo5": "playwright test -c playwright.adaptability.grupo5.config.ts",
    "test:adaptabilidad:grupo5:headed": "playwright test -c playwright.adaptability.grupo5.config.ts --headed",
    "report:adaptabilidad:grupo5": "playwright show-report reports/adaptabilidad/grupo-5"

  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "cssnano": "^5.1.10",
    "gulp": "^4.0.2",
    "gulp-autoprefixer": "^8.0.0",
    "gulp-avif": "^1.1.1",
    "gulp-cache": "^1.1.3",
    "gulp-clean": "^0.4.0",
    "gulp-concat": "^2.6.1",
    "gulp-imagemin": "^7.1.0",
    "gulp-notify": "^4.0.0",
    "gulp-plumber": "^1.2.1",
    "gulp-postcss": "^9.0.0",
    "gulp-rename": "^2.0.0",
    "gulp-sass": "^5.0.0",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-terser-js": "^5.2.2",
    "gulp-webp": "^4.0.1",
    "sass": "^1.41.1",
    "terser": "^5.14.2"
  }
}